{
  "name": "react-vite-best-practices",
  "version": "0.0.0",
  "private": true,
  "description": "A documented and tested foundation for production-ready React applications.",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vite",
    "build": "pnpm run build:production",
    "build:development": "pnpm typecheck && vite build --mode development",
    "build:production": "pnpm typecheck && vite build --mode production",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.4",
    "@rc-component/util": "^1.13.0",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.2",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "lodash-es": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
